# CabinetZone — Apache config for GoDaddy shared hosting

# ── Correct MIME types ──────────────────────────────────────────
AddType image/svg+xml          .svg
AddType image/webp              .webp
AddType video/mp4               .mp4
AddType video/quicktime         .mov
AddType video/webm              .webm
AddType font/woff2              .woff2
AddType application/manifest+json .json

# ── Compression (speeds up page load) ──────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── Browser caching ────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML — short cache so updates appear quickly
  ExpiresByType text/html                   "access plus 1 hour"
  # Assets — long cache (they're fingerprinted by content)
  ExpiresByType image/jpeg                  "access plus 1 year"
  ExpiresByType image/png                   "access plus 1 year"
  ExpiresByType image/webp                  "access plus 1 year"
  ExpiresByType image/svg+xml               "access plus 1 year"
  ExpiresByType video/mp4                   "access plus 1 year"
  ExpiresByType video/quicktime             "access plus 1 year"
  ExpiresByType text/css                    "access plus 1 month"
  ExpiresByType application/javascript      "access plus 1 month"
  ExpiresByType font/woff2                  "access plus 1 year"
</IfModule>

# ── Custom 404 page (redirect to home if page not found) ───────
ErrorDocument 404 /index.html

# ── Security headers ───────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Block access to sensitive dev files ────────────────────────
<FilesMatch "\.(mjs|gitignore|gitattributes)$">
  Order allow,deny
  Deny from all
</FilesMatch>
